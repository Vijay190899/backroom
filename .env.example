# --- LLM provider (see docs/ARCHITECTURE.md §5.1) ---
# openrouter (default) | anthropic
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=Backroom
OPENROUTER_SITE_URL=https://github.com/Vijay190899/backroom
OPENROUTER_FEE_PCT=5.5
# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Model roles: canonical IDs, mapped per provider by llm/registry.py (§5.2) ---
LLM_PLANNER_MODEL=claude-sonnet-5-5
LLM_PLANNER_EFFORT=medium
LLM_WORKER_MODEL=claude-haiku-5-5
LLM_WORKER_EFFORT=low
LLM_VERIFIER_MODEL=claude-haiku-5-5
LLM_VERIFIER_EFFORT=low
LLM_HEAL_MODEL=claude-haiku-5-5
LLM_HEAL_EFFORT=low
LLM_ESCALATION_MODEL=claude-sonnet-5-5
LLM_ESCALATION_EFFORT=medium
LLM_ASK_MODEL=claude-sonnet-5-5
LLM_ASK_EFFORT=low

# --- Guards ---
LLM_DAILY_BUDGET_USD=3
EXPLORE_MAX_STEPS=25
EXPLORE_MAX_USD=0.05
DEMO_ACCESS_CODE=change-me
# live | replay
DEMO_MODE=live

# --- Infra ---
DATABASE_URL=postgresql://backroom:backroom@localhost:5432/backroom
PORTALS_BASE_URL=http://localhost:8001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Portal credentials (mock; resolved by the secret vault, never sent to the LLM) ---
GRAINLINE_USER=lena@haferundbohne.example
GRAINLINE_PASSWORD=change-me
# Leave empty: the seed step generates one
GRAINLINE_TOTP_SECRET=
TILLDESK_USER=lena
TILLDESK_PASSWORD=change-me

# --- Data ---
DATA_SEED=44

# --- Optional (P1) ---
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
