# Chromium and its system dependencies come preinstalled; the tag must match the
# playwright version in uv.lock.
FROM mcr.microsoft.com/playwright/python:v1.65.0-noble

COPY --from=ghcr.io/astral-sh/uv:0.13 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
COPY services/api services/api
COPY services/portals services/portals
COPY data data
COPY bench bench
RUN uv sync --frozen --no-dev --package backroom-api

EXPOSE 8000
CMD ["uv", "run", "--no-sync", "uvicorn", "backroom_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
